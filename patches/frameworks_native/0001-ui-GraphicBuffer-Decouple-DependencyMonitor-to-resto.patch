From 9c466f338c588ae74313b4bf64c8a890b9a15aec Mon Sep 17 00:00:00 2001
From: marcmyworld <moviesminister@gmail.com>
Date: Fri, 11 Sep 2026 16:52:52 +0530
Subject: [PATCH] ui: GraphicBuffer: Decouple DependencyMonitor to restore
 256-byte ABI

In Android 16 (Baklava), DependencyMonitor mDependencyMonitor was added
as an inline member variable to class GraphicBuffer, which increased
sizeof(GraphicBuffer) from 256 bytes (0x100) to 3376 bytes (0xd30).

Proprietary vendor camera blobs (such as Xiaomi/TrueSight skin beautifier,
video bokeh, filters, etc.) are compiled against pre-Baklava headers with
sizeof(GraphicBuffer) == 256 bytes and call operator new(256). The constructor
then overwrites past the allocation into adjacent heap chunks, triggering
Scudo chunk header corruption and crashes in camera preview threads.

Decouple DependencyMonitor from GraphicBuffer's struct layout by returning
a reference via getDependencyMonitor(), restoring sizeof(GraphicBuffer) to
0x100 bytes while preserving compilation for consumers like SurfaceFlinger.
---
 libs/ui/GraphicBuffer.cpp          | 18 ++++++------------
 libs/ui/include/ui/GraphicBuffer.h |  7 +++----
 2 files changed, 9 insertions(+), 16 deletions(-)

diff --git a/libs/ui/GraphicBuffer.cpp b/libs/ui/GraphicBuffer.cpp
index b5dd98b..dcfb88c 100644
--- a/libs/ui/GraphicBuffer.cpp
+++ b/libs/ui/GraphicBuffer.cpp
@@ -18,6 +18,7 @@
 #define ATRACE_TAG ATRACE_TAG_GRAPHICS
 
 #include <ui/GraphicBuffer.h>
+#include <ui/DependencyMonitor.h>
 
 #include <cutils/atomic.h>
 
@@ -94,6 +95,11 @@ AHardwareBuffer const* GraphicBuffer::toAHardwareBuffer() const {
     return reinterpret_cast<AHardwareBuffer const*>(this);
 }
 
+DependencyMonitor& GraphicBuffer::getDependencyMonitor() {
+    static DependencyMonitor sMonitor;
+    return sMonitor;
+}
+
 GraphicBuffer::GraphicBuffer()
     : BASE(), mOwner(ownData), mBufferMapper(GraphicBufferMapper::get()),
       mInitCheck(NO_ERROR), mId(getUniqueId()), mGenerationNumber(0)
@@ -106,7 +112,6 @@ GraphicBuffer::GraphicBuffer()
     usage  = 0;
     layerCount = 0;
     handle = nullptr;
-    mDependencyMonitor.setToken(std::to_string(mId));
 }
 
 // deprecated
@@ -158,8 +163,6 @@ GraphicBuffer::GraphicBuffer(const GraphicBufferAllocator::AllocationRequest& re
         layerCount = request.layerCount;
         usage = request.usage;
         usage_deprecated = int(usage);
-        std::string name = request.requestorName;
-        mDependencyMonitor.setToken(name.append(":").append(std::to_string(mId)));
     }
 }
 
@@ -257,7 +260,6 @@ status_t GraphicBuffer::initWithSize(uint32_t inWidth, uint32_t inHeight,
         usage = inUsage;
         usage_deprecated = int(usage);
         stride = static_cast<int>(outStride);
-        mDependencyMonitor.setToken(requestorName.append(":").append(std::to_string(mId)));
     }
     return err;
 }
@@ -615,14 +617,6 @@ status_t GraphicBuffer::unflatten(void const*& buffer, size_t& size, int const*&
         mBufferMapper.getTransportSize(handle, &mTransportNumFds, &mTransportNumInts);
     }
 
-    std::string name;
-    status_t err = mBufferMapper.getName(handle, &name);
-    if (err != NO_ERROR) {
-        name = "<Unknown>";
-    }
-
-    mDependencyMonitor.setToken(name.append(":").append(std::to_string(mId)));
-
     buffer = static_cast<void const*>(static_cast<uint8_t const*>(buffer) + sizeNeeded);
     size -= sizeNeeded;
     fds += numFds;
diff --git a/libs/ui/include/ui/GraphicBuffer.h b/libs/ui/include/ui/GraphicBuffer.h
index 0ebfa5d..a759ee5 100644
--- a/libs/ui/include/ui/GraphicBuffer.h
+++ b/libs/ui/include/ui/GraphicBuffer.h
@@ -23,7 +23,8 @@
 #include <string>
 #include <utility>
 #include <vector>
-#include "ui/DependencyMonitor.h"
+
+#include <ui/DependencyMonitor.h>
 
 #include <android/hardware_buffer.h>
 #include <ui/ANativeObjectBase.h>
@@ -235,7 +236,7 @@ public:
 
     void addDeathCallback(GraphicBufferDeathCallback deathCallback, void* context);
 
-    DependencyMonitor& getDependencyMonitor() { return mDependencyMonitor; }
+    DependencyMonitor& getDependencyMonitor();
 
 private:
     ~GraphicBuffer();
@@ -303,8 +304,6 @@ private:
     // and informs SurfaceFlinger that it should drop its strong pointer reference to the buffer.
     std::vector<std::pair<GraphicBufferDeathCallback, void* /*mDeathCallbackContext*/>>
             mDeathCallbacks;
-
-    DependencyMonitor mDependencyMonitor;
 };
 
 } // namespace android
-- 
2.55.0

