<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Enable auxiliary cameras selector -->
    <bool name="config_enableAuxCameras">true</bool>

    <!-- List of internal/virtual camera IDs to hide from the UI -->
    <string-array name="config_ignoredAuxCameraIds">
        <!-- <item>2</item>  Hide physical main if using logical 0 -->
        <!-- <item>3</item>  Hide physical UW if using logical 0 -->
        <item>6</item> <!-- Internal depth/virtual -->
        <item>7</item> <!-- Internal depth/virtual -->
        <item>8</item> <!-- Internal depth/virtual -->
        <item>9</item> <!-- Internal depth/virtual -->
    </string-array>

    <!-- Video profiles (Camera ID | Qualities | Max FPS) -->
    <string-array name="config_additionalVideoConfigurations">
        <!-- Rear Logical (Wide + UW) -->
        <item>0</item>
        <item>sd|hd|fhd|uhd</item>
        <item>60</item>

        <!-- Rear Main (50MP) with 4K support -->
        <item>2</item>
        <item>sd|hd|fhd|uhd</item>
        <item>60</item>

        <!-- Rear Ultrawide (50MP) with 4K support -->
        <item>3</item>
        <item>sd|hd|fhd|uhd</item>
        <item>30</item>

        <!-- Front Main (32MP) with 4K support -->
        <item>1</item>
        <item>sd|hd|fhd|uhd</item>
        <item>30</item>

        <!-- Rear Telephoto (50MP 2x) -->
        <item>4</item>
        <item>sd|hd|fhd|uhd</item>
        <item>60</item>

        <!-- Front Ultra-Wide (32MP) with 4K support -->
        <item>5</item>
        <item>sd|hd|fhd|uhd</item>
        <item>30</item>
    </string-array>
</resources>