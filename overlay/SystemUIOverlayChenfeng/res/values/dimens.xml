<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Bottom margin size when fingerprint in display is active -->
    <dimen name="keyguard_indication_margin_bottom">145dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1210.0px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" type="dimen">55.18</item>

    <!-- Top padding of the status bar. Aligns status bar items and dynamic bar
         with the physical camera pill centerline (pill: Y=38 to 134px, center Y=86.0px).
         At 22.0px padding top, status bar icons and clock (heights 21-39px) layout at center Y=86.0px. -->
    <dimen name="status_bar_padding_top">22.0px</dimen>
</resources>
